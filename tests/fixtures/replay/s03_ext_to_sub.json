{
 "scenario": "s03_ext_to_sub",
 "targets": [
  "subscription:gpt-6-astra"
 ],
 "payload": {
  "instructions": "You are the synthetic coding agent for the replay goldens.",
  "input": [
   {
    "type": "message",
    "role": "developer",
    "content": [
     {
      "type": "input_text",
      "text": "<permissions instructions>\nSynthetic sandbox: read-only; approvals are never requested.\n</permissions instructions>"
     }
    ]
   },
   {
    "type": "message",
    "role": "user",
    "content": [
     {
      "type": "input_text",
      "text": "Review the synthetic diff and fix what you find."
     }
    ]
   },
   {
    "type": "reasoning",
    "id": "rs_s03_external",
    "summary": [],
    "content": [
     {
      "type": "reasoning_text",
      "text": "Synthetic external thinking."
     }
    ],
    "encrypted_content": null
   },
   {
    "type": "reasoning",
    "id": "rs_s03_summary",
    "summary": [
     {
      "type": "summary_text",
      "text": "Check the tests next."
     }
    ]
   },
   {
    "type": "custom_tool_call",
    "status": "completed",
    "call_id": "ct_s03_patch",
    "name": "apply_patch",
    "input": "*** Begin Patch\n*** Add File: hello.txt\n+hello\n*** End Patch\n"
   },
   {
    "type": "custom_tool_call_output",
    "call_id": "ct_s03_patch",
    "output": "Success. Updated hello.txt."
   },
   {
    "type": "custom_tool_call",
    "status": "completed",
    "call_id": "ct_s03_exec",
    "name": "exec",
    "input": "print(\"synthetic\")"
   },
   {
    "type": "custom_tool_call_output",
    "call_id": "ct_s03_exec",
    "output": "synthetic"
   },
   {
    "type": "agent_message",
    "author": "/root/reviewer",
    "recipient": "/root",
    "content": [
     {
      "type": "input_text",
      "text": "Synthetic review: no blocking issues."
     }
    ]
   },
   {
    "type": "message",
    "role": "developer",
    "content": [
     {
      "type": "input_text",
      "text": "<model_switch>\nThe user was previously using a different model.\n</model_switch>"
     }
    ]
   },
   {
    "type": "message",
    "role": "user",
    "content": [
     {
      "type": "input_text",
      "text": "Now finish the change."
     }
    ]
   }
  ],
  "tools": [
   {
    "type": "function",
    "name": "exec_command",
    "description": "Run a shell command in the synthetic workspace.",
    "strict": false,
    "parameters": {
     "type": "object",
     "properties": {
      "cmd": {
       "type": "string",
       "description": "The command to run."
      }
     },
     "required": [
      "cmd"
     ],
     "additionalProperties": false
    }
   },
   {
    "type": "custom",
    "name": "apply_patch",
    "description": "Edit files with a synthetic patch.",
    "format": {
     "type": "grammar",
     "syntax": "lark",
     "definition": "start: /(.|\\n)+/"
    }
   },
   {
    "type": "web_search"
   }
  ],
  "tool_choice": "auto",
  "parallel_tool_calls": true,
  "reasoning": {
   "effort": "low",
   "summary": "auto"
  },
  "store": false,
  "stream": true,
  "include": [
   "reasoning.encrypted_content"
  ],
  "prompt_cache_key": "replay-s03"
 }
}
