{
 "scenario": "s07_subagents",
 "targets": [
  "subscription:gpt-6-astra",
  "external:deepseek/deepseek-v4.1-flash-1017",
  "external:meta/muse-spark-1.3-contributor"
 ],
 "payload": {
  "instructions": "You are the synthetic coding agent for the replay goldens.",
  "input": [
   {
    "type": "message",
    "role": "developer",
    "content": [
     {
      "type": "input_text",
      "text": "<permissions instructions>\nSynthetic sandbox: read-only; approvals are never requested.\n</permissions instructions>"
     }
    ]
   },
   {
    "type": "message",
    "role": "user",
    "content": [
     {
      "type": "input_text",
      "text": "Delegate the synthetic review."
     }
    ]
   },
   {
    "type": "agent_message",
    "author": "/root/reviewer",
    "recipient": "/root",
    "content": [
     {
      "type": "input_text",
      "text": "Synthetic review done."
     },
     {
      "type": "encrypted_content",
      "encrypted_content": "gAAAAA-synthetic-child-reply"
     }
    ]
   },
   {
    "type": "function_call_output",
    "name": "create_thread",
    "namespace": "codex_app",
    "output": "<codex_delegation>\n  <source_thread_id>00000000-0000-4000-8000-000000000001</source_thread_id>\n  <input>Synthetic follow-up task.</input>\n</codex_delegation>"
   },
   {
    "type": "agent_message",
    "author": "/root/tester",
    "recipient": "/root",
    "content": [
     {
      "type": "input_text",
      "text": "Synthetic tests pass."
     }
    ]
   },
   {
    "type": "message",
    "role": "user",
    "content": [
     {
      "type": "input_text",
      "text": "Summarise the results."
     }
    ]
   }
  ],
  "tools": [
   {
    "type": "function",
    "name": "exec_command",
    "description": "Run a shell command in the synthetic workspace.",
    "strict": false,
    "parameters": {
     "type": "object",
     "properties": {
      "cmd": {
       "type": "string",
       "description": "The command to run."
      }
     },
     "required": [
      "cmd"
     ],
     "additionalProperties": false
    }
   },
   {
    "type": "custom",
    "name": "apply_patch",
    "description": "Edit files with a synthetic patch.",
    "format": {
     "type": "grammar",
     "syntax": "lark",
     "definition": "start: /(.|\\n)+/"
    }
   },
   {
    "type": "web_search"
   }
  ],
  "tool_choice": "auto",
  "parallel_tool_calls": true,
  "reasoning": {
   "effort": "low",
   "summary": "auto"
  },
  "store": false,
  "stream": true,
  "include": [
   "reasoning.encrypted_content"
  ],
  "prompt_cache_key": "replay-s07"
 }
}
